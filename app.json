{
  "expo": {
    "name": "phase-bird",
    "slug": "phase-bird",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.savancex.phasebird",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2245784892914119~2481627053",
          "iosAppId": "ca-app-pub-2245784892914119~7199094089"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.savancex.phasebird"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f38bddc-fc4b-46bf-a858-fd4e6663f1e8"
      }
    }
  }
}
